{
  "hosting": {
    "target": "docs",
    "public": "dist",
    "ignore": ["firebase.json", "**/.*", "**/node_modules/**"],
    "cleanUrls": true,
    "redirects": [
      {
        "regex": "^/hyperliquid/add-a-trading-account/?$",
        "destination": "/hyperliquid/connect-an-account/",
        "type": 301
      },
      {
        "source": "/hyperliquid/add-a-trading-account.md",
        "destination": "/hyperliquid/connect-an-account.md",
        "type": 301
      },
      {
        "regex": "^/binance/add-a-trading-account/?$",
        "destination": "/binance/connect-an-account/",
        "type": 301
      },
      {
        "source": "/binance/add-a-trading-account.md",
        "destination": "/binance/connect-an-account.md",
        "type": 301
      }
    ],
    "headers": [
      {
        "source": "**/*.md",
        "headers": [{ "key": "Content-Type", "value": "text/markdown; charset=utf-8" }]
      },
      {
        "source": "/llms*.txt",
        "headers": [{ "key": "Content-Type", "value": "text/plain; charset=utf-8" }]
      },
      {
        "source": "/_astro/**",
        "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
      },
      {
        "source": "/screens/**",
        "headers": [{ "key": "Cache-Control", "value": "public, max-age=3600" }]
      }
    ]
  }
}
