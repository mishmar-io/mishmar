{
  "name": "mishmar",
  "version": "0.4.0",
  "mcpName": "io.github.mishmar-io/mishmar",
  "description": "Mishmar is a risk management layer for trading bots and AI agents: every order is checked against your limits before it reaches the exchange, large orders wait for your approval, and no key can trade alone. The TypeScript SDK: run the agent's signer, propose orders, read decisions.",
  "license": "Apache-2.0",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "bin": {
    "mishmar": "./dist/bin.js"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json && chmod +x dist/bin.js",
    "prepublishOnly": "npm run build",
    "typecheck": "tsc --noEmit",
    "test": "node --test \"tests/**/*.test.ts\""
  },
  "devDependencies": {
    "@types/node": "^24.3.0",
    "typescript": "^5.9.3"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mishmar-io/mishmar.git",
    "directory": "typescript"
  },
  "homepage": "https://mishmar.io",
  "keywords": [
    "trading",
    "trading-bot",
    "ai-agents",
    "risk-management",
    "pre-trade-risk",
    "hyperliquid",
    "binance",
    "mpc",
    "threshold-signatures",
    "mcp"
  ]
}
